# Copy to .env.local and fill in. See README.md → «Окружения».
#
# WHICH FILE IS WHICH
#   .env.local   staging  — what `next dev` loads, and the default for scripts run with --env=stage
#   .env.prod    production — scripts only, via --env=prod
#
# .env.prod is spelled that way on purpose. Next automatically loads .env.production and
# .env.production.local, so a production file under either of those names would be picked up by a
# local `npm run build` without anyone asking for it. `.env.prod` is not in Next's load list.
# Both are git-ignored by the blanket `.env*` rule; only this template is committed.

# ─── Supabase ────────────────────────────────────────────────────────────────
# production  ukgtmxzpzprmoutqskgq
# staging     puqmkruyhjfvhyjfriig
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: bypasses RLS. Used by admin actions, guest checkout and every script in scripts/.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Which origin this deployment answers on ─────────────────────────────────
# Not the canonical domain — that is SITE_URL in lib/constants.ts, hardcoded to https://aloe.kg.
# DEPLOY_ORIGIN is where THIS build actually serves, and the moment it differs from SITE_URL the
# app serves `Disallow: /` and a noindex meta. It is read at BUILD time, so changing it on Vercel
# needs a redeploy, not a restart.
#
#   production  UNSET. A leftover value here hides the live shop from Google — see MIGRATION.md.
#   staging     https://stage.aloe.kg
#   local       http://localhost:3000, so the admin link in order emails points at your dev server
DEPLOY_ORIGIN=http://localhost:3000

# ─── Order notifications (SMTP) ──────────────────────────────────────────────
# All optional. Unset means notifications are skipped, loudly, in the log — checkout still succeeds
# and the outcome is recorded in orders.notified_at.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to mail.hoster.kg — the name on the hoster's certificate, which does not match
# SMTP_HOST. Set it if you point staging at a different mail provider. See lib/mailer.ts.
SMTP_TLS_SERVERNAME=
# Where order notifications go. On staging and locally this MUST be a test inbox: it is the shop
# owner's real address on production.
ADMIN_NOTIFICATION_EMAIL=
