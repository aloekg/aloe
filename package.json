{
  "name": "aloe",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint --fix",
    "db:types": "echo \"db:types ← $(cat supabase/.temp/project-ref 2>/dev/null || echo \"no linked project\")\" >&2 && npx supabase gen types typescript --linked > types/database.ts.tmp && mv types/database.ts.tmp types/database.ts || (rm -f types/database.ts.tmp && echo 'db:types failed; types/database.ts left untouched' && exit 1)",
    "db:types:prod": "npm run db:link:prod && npm run db:types",
    "db:linked": "printf '%s\\n' \"$(cat supabase/.temp/project-ref 2>/dev/null || echo 'no linked project')\"",
    "db:link:prod": "npx supabase link --project-ref ukgtmxzpzprmoutqskgq",
    "db:link:stage": "npx supabase link --project-ref $(node scripts/print-ref.mjs --env=stage)",
    "db:push:prod": "npm run db:link:prod && npx supabase db push",
    "db:push:stage": "npm run db:link:stage && npx supabase db push",
    "backup:prod": "node backups/backup-db.mjs --env=prod",
    "backup:stage": "node backups/backup-db.mjs --env=stage",
    "seed:stage": "node scripts/seed-staging.mjs --env=stage",
    "seed:stage:orders": "node scripts/seed-staging-orders.mjs --env=stage",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-virtual": "^3.14.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.21.0",
    "next": "16.3.5",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^9.1.1",
    "pdfkit": "^0.19.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "sideEffects": false
}
